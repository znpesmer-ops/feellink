# === ZORUNLU ===
# MongoDB (PostgreSQL değil!). Atlas: https://www.mongodb.com/cloud/atlas
DATABASE_URL=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/feellink?retryWrites=true&w=majority

# JWT için gizli anahtar (production'da mutlaka kendi ürettiğinizi kullanın: openssl rand -base64 48)
JWT_SECRET=buraya_uzun_rastgele_string_yazin

# === ÖNERİLEN ===
FRONTEND_URL=https://feellink.io
# Vercel Blob (Storage) token - dosya yükleme için
BLOB_READ_WRITE_TOKEN=

# === E-POSTA (opsiyonel) ===
# MAIL_MODE: prod veya production = mail gönderilir; dev veya boş = sadece log
MAIL_MODE=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=info@feellink.io
MAIL_FROM_NAME=feellink
SUPPORT_EMAIL=destek@feellink.io

# === OPSİYONEL ===
# REDIS_HOST=
# REDIS_PORT=6379
# MEILISEARCH_HOST=https://...
# MEILISEARCH_API_KEY=
