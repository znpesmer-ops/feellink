// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionPlan {
  FREE
  PRO
  ORI
}

enum UserRole {
  art_lover
  corporate
  collector
  artist
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION // Kullanıcı hesap silme talebi; 15 gün içinde girişle geri alınabilir
}

enum OtpPurpose {
  signup_verification
  password_reset
}

model User {
  id                        String           @id @default(cuid())
  username                  String           @unique
  email                     String           @unique
  password                  String
  fullName                  String?
  bio                       String?
  avatar                    String?
  coverImage                String?
  roles                     UserRole[]       @default([])
  extras                    String[]         @default([])
  plan                      SubscriptionPlan @default(FREE)
  badges                    String[]         @default([])
  isPrivate                 Boolean          @default(false)
  isVerified                Boolean          @default(false)
  isAdmin                   Boolean          @default(false)
  superAdmin                Boolean          @default(false) // 🔥 GOD-MODE
  followerCount             Int              @default(0)
  followingCount            Int              @default(0)
  isOnline                  Boolean          @default(false)
  lastSeen                  DateTime?
  lastActiveAt              DateTime?        // presence heartbeat; timeout ile offline kararı
  passwordResetToken        String?
  passwordResetExpires      DateTime?
  usernameLastChangedAt     DateTime?
  nameLastChangedAt         DateTime?
  website                   String?
  dateOfBirth               DateTime?
  country                   String?
  city                      String?
  gender                    String?
  profileCompleted          Boolean          @default(false)
  phoneNumber               String?
  phoneVerified             Boolean          @default(false)
  gdprConsent               Boolean          @default(false)
  gdprConsentAt             DateTime?
  analyticsConsent          Boolean          @default(false)
  showProfileColorSignature Boolean?         @default(true) // 🎨 Profil renk imzasını göster/gizle
  termsAccepted             Boolean          @default(false) // ✅ Kullanıcı sözleşmesi onay durumu
  termsAcceptedAt           DateTime? // ✅ Kullanıcı sözleşmesi onay tarihi
  accountStatus             AccountStatus    @default(ACTIVE) // 🔒 Hesap durumu
  suspendedAt               DateTime? // 🔒 Askıya alma tarihi
  suspendedUntil            DateTime? // 🔒 Askıya alma bitiş tarihi
  suspensionReason          String? // 🔒 Askıya alma nedeni
  suspensionNote            String? // 🔒 Admin iç notu
  suspendedByAdminId        String?          // 🔒 Askıya alan admin ID
  deletionRequestedAt       DateTime? // 🔒 Kullanıcı hesap silme talebi tarihi
  scheduledDeletionAt       DateTime? // 🔒 Kalıcı silme tarihi (deletionRequestedAt + 15 gün)
  isDeleted                 Boolean          @default(false) // 🗑️ Soft delete flag
  deletedAt                 DateTime? // 🗑️ Soft delete timestamp
  deletedBy                 String?          // 🗑️ Admin who deleted
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  /// Profil gönderiler sekmesi serbest sıra (post id listesi, artwork hariç)
  profilePostOrder          String[]         @default([])
  /// Profil eserler sekmesi serbest sıra (artwork post id listesi)
  profileArtworkOrder       String[]         @default([])

  // Relations
  posts                      Post[]
  articles                   Article[]
  comments                   Comment[]
  likes                      Like[]
  followers                  Follow[]                @relation("Follower")
  following                  Follow[]                @relation("Following")
  blockedBy                  Block[]                 @relation("BlockedUser")
  blockedUsers               Block[]                 @relation("BlockerUser")
  followRequestsReceived     FollowRequest[]         @relation("RequestedUser")
  followRequestsSent         FollowRequest[]         @relation("RequesterUser")
  notificationsReceived      Notification[]          @relation("ReceivedNotifications")
  notificationsSent          Notification[]          @relation("SentNotifications")
  stories                    Story[]
  storyViews                 StoryView[]
  refreshTokens              RefreshToken[]
  savedPosts                 SavedPost[]
  savedArtworks              SavedArtwork[]
  messages                   Message[]
  conversations              UserConversation[]
  commentReactions           CommentReaction[]
  articleComments            ArticleComment[]
  articleCommentLikes        ArticleCommentLike[]
  commentLikes               CommentLike[]
  notificationPreference     NotificationPreference?
  collections                Collection[]            @relation("CollectionOwner")
  events                     Event[]                 @relation("EventOwner")
  eventComments              EventComment[]          @relation("EventCommentAuthor")
  eventParticipants          EventParticipant[]      @relation("EventParticipantUser")
  ticketPurchases            TicketPurchase[]        @relation("TicketPurchaseUser")
  auditLogs                  AuditLog[]              @relation("AuditLogActor")
  jobListings                JobListing[]
  jobApplications            JobApplication[]        @relation("JobApplications")
  roleChangeRequests         RoleChangeRequest[]     @relation("RoleChangeRequests")
  reviewedRoleChangeRequests RoleChangeRequest[]     @relation("ReviewedRoleChangeRequests")
  highlights                 Highlight[]
  monthlyHighlightsAsMuseum  MonthlyHighlight[]      @relation("MonthlyHighlightMuseum")
  collectionItems            CollectionItem[]        @relation("CollectionItemAddedBy")
  reportsMade                UserReport[]            @relation("ReportsMade")
  reportsReceived            UserReport[]            @relation("ReportsReceived")
  emailChangeRequests        EmailChangeRequest[]
  phoneVerifications         PhoneVerification[]
  roleChangeLogs             RoleChangeLog[]         @relation("RoleChanges")

  @@map("users")
}

model Post {
  id           String    @id @default(cuid())
  userId       String
  caption      String?
  title        String? // 🎨 Eser adı (artwork için)
  location     String?
  type         String    @default("post") // "post" | "artwork"
  code         String? // Artwork için otomatik üretilen kod (PA24-00001 gibi)
  colors       String[]  @default([]) // Artwork için otomatik çıkarılan renkler (HEX formatında) - DEPRECATED
  colorPalette String[]  @default([]) // 🎨 Basit renk paleti: hex string listesi (frontend'den gelir)
  artworkCreatedDate DateTime? // 🎨 Eserin oluşturulduğu tarih (kullanıcı girişi, opsiyonel)
  isDeleted    Boolean   @default(false) // 🗑️ Soft delete flag
  deletedAt    DateTime? // 🗑️ Soft delete timestamp
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user                       User               @relation(fields: [userId], references: [id])
  media                      PostMedia[]
  comments                   Comment[]
  likes                      Like[]
  hashtags                   PostHashtag[]
  savedBy                    SavedPost[]
  highlightCover             Highlight[]        @relation("HighlightCoverPost")
  highlightItems             HighlightItem[]
  collectionItems            CollectionItem[]
  savedByArtworks            SavedArtwork[]     @relation("SavedByArtworks")
  monthlyHighlightsAsArtwork MonthlyHighlight[] @relation("MonthlyHighlightArtwork")

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id           String   @id @default(cuid())
  postId       String
  type         String // 'image' | 'video'
  url          String
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])

  @@index([postId])
  @@map("post_media")
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  id        String @id @default(cuid())
  postId    String
  hashtagId String

  post    Post    @relation(fields: [postId], references: [id])
  hashtag Hashtag @relation(fields: [hashtagId], references: [id])

  @@unique([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  parentId  String? // For nested comments
  isPinned  Boolean  @default(false) // Sabitlenmiş yorum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post              Post               @relation(fields: [postId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  parent            Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies           Comment[]          @relation("CommentReplies")
  reactions         CommentReaction[]
  likes             CommentLike[]
  monthlyHighlights MonthlyHighlight[] @relation("MonthlyHighlightComment")

  @@index([postId])
  @@index([userId])
  @@index([postId, isPinned])
  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model FollowRequest {
  id          String   @id @default(cuid())
  requesterId String
  requestedId String
  createdAt   DateTime @default(now())

  requester User @relation("RequesterUser", fields: [requesterId], references: [id])
  requested User @relation("RequestedUser", fields: [requestedId], references: [id])

  @@unique([requesterId, requestedId])
  @@index([requestedId])
  @@index([requesterId])
  @@map("follow_requests")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id])
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String // 'like', 'comment', 'follow', 'follow_request', 'follow_accept', 'message', 'mention', 'reply', 'comment_like', 'job_application_received', 'job_application_status_changed', 'collection_added'
  message    String? // Bildirim metni (örn: "Ahmet gönderini beğendi")
  fromUserId String?
  postId     String?
  articleId  String?
  commentId  String?
  targetUrl  String? // Eski alan (geriye uyumluluk için)
  targetPath String? // Yeni alan: bildirime tıklandığında gidilecek Next.js route path
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User  @relation("ReceivedNotifications", fields: [userId], references: [id])
  fromUser User? @relation("SentNotifications", fields: [fromUserId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String    @id @default(cuid())
  userId    String    @unique
  mention   Boolean   @default(true)
  follow    Boolean   @default(true)
  like      Boolean   @default(true)
  comment   Boolean   @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType String // 'image' | 'video'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  views StoryView[]

  @@index([userId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_views")
}

model FeedCache {
  id        String   @id @default(cuid())
  userId    String
  postIds   String[] // Array of post IDs
  updatedAt DateTime @default(now())

  @@unique([userId])
  @@map("feed_cache")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String  
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String  
  postId    String  
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

model SavedArtwork {
  id        String   @id @default(cuid())
  userId    String  
  postId    String  
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation("SavedByArtworks", fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_artworks")
}

enum ConversationContext {
  DIRECT
  JOB_APPLICATION // ✅ Başvuruya bağlı sohbet (LinkedIn/Upwork mantığı)
}

model Conversation {
  id            String              @id @default(cuid())
  lastMessage   String? // 🔥 Son mesaj içeriği (sol panel için)
  context       ConversationContext @default(DIRECT) // "DIRECT" | "JOB_APPLICATION" - mesaj bağlamı
  jobId         String?             // İlan üzerinden mesaj ise ilan ID'si
  applicationId String?             // ✅ Başvuruya bağlı sohbet ise başvuru ID'si (LinkedIn/Upwork mantığı)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  participants  UserConversation[]
  messages      Message[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([context, jobId])
  @@index([context, applicationId]) // ✅ Başvuruya bağlı sohbetler için index
  @@map("conversations")
}

model UserConversation {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  isDeleted      Boolean      @default(false) // Kullanıcıya özel sohbet silme (soft delete)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, isDeleted])
  @@map("user_conversations")
}

model Message {
  id             String               @id @default(cuid())
  content        String?
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  fileType       String?
  senderId       String
  conversationId String
  context        ConversationContext? @default(DIRECT) // "DIRECT" | "JOB_APPLICATION" - mesaj bağlamı (conversation'dan inherit edilir)
  jobId          String?              // İlan üzerinden mesaj ise ilan ID'si (conversation'dan inherit edilir)
  applicationId  String?              // ✅ Başvuruya bağlı sohbet ise başvuru ID'si (conversation'dan inherit edilir)
  read           Boolean              @default(false)
  isEdited       Boolean              @default(false)
  isDeleted      Boolean              @default(false)
  isRequest      Boolean              @default(false) // 🔥 Instagram tarzı mesaj isteği
  messageType    String               @default("TEXT") // TEXT | POST_SHARE
  sharedPostId   String?              // POST_SHARE: paylaşılan gönderi
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sender         User                 @relation(fields: [senderId], references: [id])
  conversation   Conversation         @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([read])
  @@index([sharedPostId])
  @@index([isRequest])
  @@index([context, jobId])
  @@index([context, applicationId]) // ✅ Başvuruya bağlı mesajlar için index
  @@map("messages")
}

model Article {
  id          String    @id @default(cuid())
  title       String
  content     String
  coverImage  String?
  excerpt     String?
  isPublished Boolean   @default(false)
  scheduledAt DateTime?
  views       Int       @default(0)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User             @relation(fields: [authorId], references: [id])
  comments ArticleComment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isPublished])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article              @relation(fields: [articleId], references: [id])
  user    User                 @relation(fields: [userId], references: [id])
  parent  ArticleComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies ArticleComment[]     @relation("CommentReplies")
  likes   ArticleCommentLike[]

  @@index([articleId])
  @@index([parentId])
  @@index([userId])
  @@map("article_comments")
}

model ArticleCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment ArticleComment @relation(fields: [commentId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("article_comment_likes")
}

model JobListing {
  id          String   @id @default(cuid())
  title       String
  description String
  company     String?
  location    String?
  salary      String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User             @relation(fields: [createdById], references: [id])
  createdById  String
  applications JobApplication[]

  @@index([createdAt])
  @@index([createdById])
  @@map("job_listings")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model JobApplication {
  id           String     @id @default(cuid())
  jobListingId String
  jobListing   JobListing @relation(fields: [jobListingId], references: [id])

  applicantId String
  applicant   User   @relation("JobApplications", fields: [applicantId], references: [id])

  coverLetter      String?
  portfolioUrl     String?
  portfolioFileUrl String? // Yüklenen portfolyo dosyası URL'i
  cvUrl            String?

  status ApplicationStatus @default(PENDING)

  conversationId String? // ✅ Başvuru onaylandığında oluşturulan sohbet ID'si (LinkedIn/Upwork mantığı)

  expiresAt      DateTime? // 30 günlük yanıt süresi (başvuru tarihinden itibaren)
  reminderSentAt DateTime? // Son hatırlatma bildirimi gönderilme tarihi

  // Admin özellikleri (sadece ilan sahibi görür)
  adminNote String? // Admin için özel notlar (aday görmez)
  tags      String[] @default([]) // Etiketler: ["öncelikli", "portfolyo-güçlü", vb.]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activities ApplicationActivity[]

  @@unique([jobListingId, applicantId])
  @@index([jobListingId])
  @@index([applicantId])
  @@index([status])
  @@index([conversationId]) // ✅ Conversation ID için index
  @@map("job_applications")
}

model ApplicationActivity {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id])

  action  String // "APPROVED" | "REJECTED" | "REVIEWED" | "NOTE_ADDED" | "TAG_ADDED" | "TAG_REMOVED" | "MAIL_SENT"
  details String? // Ek bilgiler (örn: eklenen etiket, not içeriği özeti)

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_activities")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  ownerId     String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner             User               @relation("CollectionOwner", fields: [ownerId], references: [id])
  items             CollectionItem[]
  monthlyHighlights MonthlyHighlight[] @relation("MonthlyHighlightCollection")

  @@index([ownerId])
  @@index([createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  postId       String // Post modeli artwork'leri de içeriyor (type="artwork")
  addedById    String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id])
  post       Post       @relation(fields: [postId], references: [id])
  addedBy    User       @relation("CollectionItemAddedBy", fields: [addedById], references: [id])

  @@unique([collectionId, postId])
  @@index([collectionId, order])
  @@index([postId])
  @@map("collection_items")
}

model Event {
  id               String    @id @default(cuid())
  title            String
  description      String?
  coverImage       String?
  date             DateTime
  participantCount Int       @default(0)
  maxParticipants  Int? // null = sınırsız kontenjan (talep/onay akışı)
  ticketUrl        String?
  price            Float     @default(0)
  isFree           Boolean   @default(true)
  location         String?
  ownerId          String
  reminderMailSent Boolean   @default(false) // 24 saat hatırlatma maili gönderildi mi?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner        User               @relation("EventOwner", fields: [ownerId], references: [id])
  comments     EventComment[]
  participants EventParticipant[] @relation("EventParticipants")
  tickets      Ticket[]

  @@index([ownerId])
  @@index([date])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("events")
}

model EventComment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  eventId   String
  authorId  String

  event  Event @relation(fields: [eventId], references: [id])
  author User  @relation("EventCommentAuthor", fields: [authorId], references: [id])

  @@index([eventId])
  @@index([authorId])
  @@index([createdAt])
  @@map("event_comments")
}

enum EventParticipantStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventParticipant {
  id                String                 @id @default(cuid())
  eventId           String
  userId            String
  status            EventParticipantStatus @default(PENDING)
  reminderSentAt    DateTime? // 30 dakika hatırlatma için
  reminder24hSentAt DateTime? // 24 saat hatırlatma için
  reminder2hSentAt  DateTime? // 2 saat önce hatırlatma için
  createdAt         DateTime               @default(now())

  event Event @relation("EventParticipants", fields: [eventId], references: [id])
  user  User  @relation("EventParticipantUser", fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reminderSentAt])
  @@index([reminder24hSentAt])
  @@index([reminder2hSentAt])
  @@map("event_participants")
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  type      String
  price     Float
  capacity  Int
  sold      Int      @default(0)
  qrCodeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event            @relation(fields: [eventId], references: [id])
  purchases TicketPurchase[]

  @@index([eventId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketPurchase {
  id        String    @id @default(cuid())
  ticketId  String
  userId    String
  code      String    @unique
  qrUrl     String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation("TicketPurchaseUser", fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([used])
  @@index([createdAt])
  @@map("ticket_purchases")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // 'user.ban', 'post.delete', 'role.update', etc.
  target    String? // 'user:abc123', 'post:xyz789', etc.
  meta      Json? // Additional context data
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([target])
  @@map("audit_logs")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("feature_flags")
}

model Highlight {
  id          String          @id @default(cuid())
  title       String
  coverPostId String?
  coverPost   Post?           @relation("HighlightCoverPost", fields: [coverPostId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  items       HighlightItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("highlights")
}

model HighlightItem {
  id          String    @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id])
  postId      String
  post        Post      @relation(fields: [postId], references: [id])
  sortOrder   Int       @default(0)

  @@unique([highlightId, postId])
  @@index([highlightId])
  @@index([postId])
  @@map("highlight_items")
}

enum ReportReason {
  HARASSMENT
  SPAM
  HATE_SPEECH
  IMPERSONATION
  INAPPROPRIATE_CONTENT
}

model UserReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String
  conversationId String?
  messageId      String?
  reason         ReportReason
  note           String?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())

  reporter     User @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
  @@map("user_reports")
}

model RoleChangeRequest {
  id            String    @id @default(cuid())
  userId        String   
  requestedRole UserRole
  message       String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy    String?   // Admin ID
  reviewedAt    DateTime?
  reviewNote    String? // Admin notu
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User  @relation("RoleChangeRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedRoleChangeRequests", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@map("role_change_requests")
}

model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("email_change_requests")
}

model PhoneVerification {
  id          String   @id @default(cuid())
  userId      String  
  phoneNumber String
  code        String
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("phone_verifications")
}

// Tek kullanımlık e-posta doğrulama kodu (kayıt + şifre sıfırlama)
model EmailOtp {
  id           String     @id @default(cuid())
  email        String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?  // Yeni kod gönderilince eski kodlar iptal edilir
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([email])
  @@index([purpose])
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

model RoleChangeLog {
  id        String   @id @default(cuid())
  userId    String  
  oldRoles  String[]
  newRoles  String[]
  changedBy String  
  createdAt DateTime @default(now())

  user User @relation("RoleChanges", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("role_change_logs")
}

// ✅ Ayın Öne Çıkanları - Admin kontrollü veya otomatik seçim
model MonthlyHighlight {
  id           String   @id @default(cuid())
  year         Int // Yıl (2024, 2025, vb.)
  month        Int // Ay (1-12)
  museumId     String?  // Ayın Müzesi (User ID - museum role)
  artworkId    String?  // Ayın Eseri (Post ID - type="artwork")
  commentId    String?  // Ayın Yorumu (Comment ID)
  collectionId String?  // Ayın Koleksiyonu (Collection ID)
  isAuto       Boolean  @default(false) // Otomatik seçim mi, admin override mi?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations (optional - nullable)
  museum     User?       @relation("MonthlyHighlightMuseum", fields: [museumId], references: [id])
  artwork    Post?       @relation("MonthlyHighlightArtwork", fields: [artworkId], references: [id])
  comment    Comment?    @relation("MonthlyHighlightComment", fields: [commentId], references: [id])
  collection Collection? @relation("MonthlyHighlightCollection", fields: [collectionId], references: [id])

  @@unique([year, month]) // Her ay için sadece bir kayıt (bu zaten bir index oluşturur)
  @@index([museumId])
  @@index([artworkId])
  @@index([commentId])
  @@index([collectionId])
  @@map("monthly_highlights")
}
