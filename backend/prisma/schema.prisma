// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  PRO
  ORI
}

enum UserRole {
  art_lover
  corporate
  collector
  artist
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  password       String
  fullName       String?
  bio            String?
  avatar         String?
  roles          UserRole[]       @default([])
  extras         String[]         @default([])
  plan           SubscriptionPlan @default(FREE)
  badges         String[]         @default([])
  isPrivate      Boolean  @default(false)
  isVerified     Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  isOnline       Boolean  @default(false)
  lastSeen       DateTime?
  passwordResetToken   String?   @db.VarChar(255)
  passwordResetExpires DateTime?
  usernameLastChangedAt DateTime?
  nameLastChangedAt     DateTime?
  website               String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  posts                  Post[]
  articles               Article[]
  comments               Comment[]
  likes                  Like[]
  followers              Follow[]             @relation("Follower")
  following              Follow[]             @relation("Following")
  blockedBy              Block[]              @relation("BlockedUser")
  blockedUsers           Block[]              @relation("BlockerUser")
  followRequestsReceived FollowRequest[]      @relation("RequestedUser")
  followRequestsSent     FollowRequest[]      @relation("RequesterUser")
  notificationsReceived  Notification[]       @relation("ReceivedNotifications")
  notificationsSent      Notification[]       @relation("SentNotifications")
  stories                Story[]
  storyViews             StoryView[]
  refreshTokens          RefreshToken[]
  savedPosts             SavedPost[]
  messages               Message[]
  conversations          UserConversation[]
  commentReactions       CommentReaction[]
  articleComments        ArticleComment[]
  articleCommentLikes    ArticleCommentLike[]
  commentLikes           CommentLike[]
  notificationPreference NotificationPreference?
  collections            Collection[]         @relation("CollectionOwner")
  events                 Event[]              @relation("EventOwner")
  eventComments          EventComment[]       @relation("EventCommentAuthor")
  eventParticipants      EventParticipant[]   @relation("EventParticipantUser")
  ticketPurchases        TicketPurchase[]     @relation("TicketPurchaseUser")
  auditLogs              AuditLog[]           @relation("AuditLogActor")
  jobListings            JobListing[]
  jobApplications        JobApplication[]      @relation("JobApplications")
  highlights             Highlight[]

  @@index([username])
  @@index([email])
  @@map("users")
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  caption      String?
  title        String?  // 🎨 Eser adı (artwork için)
  location     String?
  type         String   @default("post") // "post" | "artwork"
  code         String?  // Artwork için otomatik üretilen kod (PA24-00001 gibi)
  colors       String[] @default([]) // Artwork için otomatik çıkarılan renkler (HEX formatında) - DEPRECATED
  colorPalette String[] @default([]) // 🎨 Basit renk paleti: hex string listesi (frontend'den gelir)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  comments Comment[]
  likes    Like[]
  hashtags PostHashtag[]
  savedBy  SavedPost[]
  highlightCover Highlight[] @relation("HighlightCoverPost")
  highlightItems HighlightItem[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id           String   @id @default(cuid())
  postId       String
  type         String // 'image' | 'video'
  url          String
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_media")
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  posts PostHashtag[]

  @@index([name])
  @@map("hashtags")
}

model PostHashtag {
  id        String @id @default(cuid())
  postId    String
  hashtagId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  parentId  String? // For nested comments
  isPinned  Boolean  @default(false) // Sabitlenmiş yorum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]        @relation("CommentReplies")
  reactions CommentReaction[]
  likes     CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([postId, isPinned])
  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model FollowRequest {
  id          String   @id @default(cuid())
  requesterId String
  requestedId String
  createdAt   DateTime @default(now())

  requester User @relation("RequesterUser", fields: [requesterId], references: [id], onDelete: Cascade)
  requested User @relation("RequestedUser", fields: [requestedId], references: [id], onDelete: Cascade)

  @@unique([requesterId, requestedId])
  @@index([requestedId])
  @@index([requesterId])
  @@map("follow_requests")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String // 'like', 'comment', 'follow', 'follow_request', 'follow_accept', 'message', 'mention', 'reply', 'comment_like', 'job_application_received', 'job_application_status_changed'
  message    String?  // Bildirim metni (örn: "Ahmet gönderini beğendi")
  fromUserId String?
  postId     String?
  articleId  String?
  commentId  String?
  targetUrl  String?  // Eski alan (geriye uyumluluk için)
  targetPath String?  // Yeni alan: bildirime tıklandığında gidilecek Next.js route path
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user    User  @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User? @relation("SentNotifications", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String  @unique
  mention Boolean @default(true)
  follow  Boolean @default(true)
  like    Boolean @default(true)
  comment Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  mediaUrl  String
  mediaType String // 'image' | 'video'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([userId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_views")
}

model FeedCache {
  id        String   @id @default(cuid())
  userId    String
  postIds   String[] // Array of post IDs
  updatedAt DateTime @default(now())

  @@unique([userId])
  @@index([userId])
  @@map("feed_cache")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

model Conversation {
  id            String             @id @default(cuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  participants  UserConversation[]
  messages      Message[]

  @@index([createdAt])
  @@map("conversations")
}

model UserConversation {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@map("user_conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String?
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  fileType       String?
  senderId       String
  conversationId String
  read           Boolean      @default(false)
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([read])
  @@map("messages")
}

model Article {
  id          String           @id @default(cuid())
  title       String
  content     String
  coverImage  String?
  excerpt     String?
  isPublished Boolean          @default(false)
  scheduledAt DateTime?
  views       Int              @default(0)
  authorId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments ArticleComment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isPublished])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleComment {
  id        String             @id @default(cuid())
  articleId String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  article  Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ArticleComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ArticleComment[]   @relation("CommentReplies")
  likes    ArticleCommentLike[]

  @@index([articleId])
  @@index([parentId])
  @@index([userId])
  @@map("article_comments")
}

model ArticleCommentLike {
  id         String        @id @default(cuid())
  commentId  String
  userId     String
  createdAt  DateTime      @default(now())

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("article_comment_likes")
}

model JobListing {
  id          String   @id @default(cuid())
  title       String
  description String
  company     String?
  location    String?
  salary      String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String
  applications JobApplication[]

  @@index([createdAt])
  @@index([createdById])
  @@map("job_listings")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model JobApplication {
  id           String            @id @default(cuid())
  jobListingId String
  jobListing   JobListing         @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  applicantId  String
  applicant    User               @relation("JobApplications", fields: [applicantId], references: [id], onDelete: Cascade)

  coverLetter  String?
  portfolioUrl String?
  cvUrl        String?

  status       ApplicationStatus  @default(PENDING)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([jobListingId, applicantId])
  @@index([jobListingId])
  @@index([applicantId])
  @@index([status])
  @@map("job_applications")
}

model CommentLike {
  id         String   @id @default(cuid())
  commentId  String
  userId     String
  createdAt  DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt])
  @@map("collections")
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String?
  coverImage      String?
  date            DateTime
  participantCount Int      @default(0)
  ticketUrl       String?
  price           Float    @default(0)
  isFree          Boolean  @default(true)
  location        String?
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  comments EventComment[]
  participants EventParticipant[] @relation("EventParticipants")
  tickets Ticket[]

  @@index([ownerId])
  @@index([date])
  @@index([createdAt])
  @@map("events")
}

model EventComment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  eventId   String
  authorId  String

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation("EventCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([authorId])
  @@index([createdAt])
  @@map("event_comments")
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation("EventParticipants", fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("EventParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
  @@map("event_participants")
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  type      String
  price     Float
  capacity  Int
  sold      Int      @default(0)
  qrCodeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purchases TicketPurchase[]

  @@index([eventId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketPurchase {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  code      String   @unique
  qrUrl     String?
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation("TicketPurchaseUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([code])
  @@index([used])
  @@index([createdAt])
  @@map("ticket_purchases")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId  String
  action   String   // 'user.ban', 'post.delete', 'role.update', etc.
  target   String?  // 'user:abc123', 'post:xyz789', etc.
  meta     Json?    // Additional context data
  ip       String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([target])
  @@map("audit_logs")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("feature_flags")
}

model Highlight {
  id          String   @id @default(cuid())
  title       String
  coverPostId String?
  coverPost   Post?    @relation("HighlightCoverPost", fields: [coverPostId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       HighlightItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("highlights")
}

model HighlightItem {
  id          String   @id @default(cuid())
  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)

  @@unique([highlightId, postId])
  @@index([highlightId])
  @@index([postId])
  @@map("highlight_items")
}
