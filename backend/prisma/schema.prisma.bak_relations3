// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  PRO
  ORI
}

enum UserRole {
  art_lover
  corporate
  collector
  artist
}

model User {
  id                    String           @id @default(auto()) @map("_id") @db.ObjectId
  username              String           @unique
  email                 String           @unique
  password              String
  fullName              String?
  bio                   String?
  avatar                String?
  roles                 UserRole[]       @default([])
  extras                String[]         @default([])
  plan                  SubscriptionPlan @default(FREE)
  badges                String[]         @default([])
  isPrivate             Boolean          @default(false)
  isVerified            Boolean          @default(false)
  isAdmin               Boolean          @default(false)
  superAdmin            Boolean          @default(false) // 🔥 GOD-MODE
  followerCount         Int              @default(0)
  followingCount        Int              @default(0)
  isOnline              Boolean          @default(false)
  lastSeen              DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  usernameLastChangedAt DateTime?
  nameLastChangedAt     DateTime?
  website               String?
  dateOfBirth           DateTime?
  country               String?
  city                  String?
  gender                String?
  profileCompleted      Boolean          @default(false)
  phoneNumber           String?
  phoneVerified         Boolean          @default(false)
  gdprConsent           Boolean          @default(false)
  gdprConsentAt         DateTime?
  analyticsConsent      Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  posts                  Post[]
  articles               Article[]
  comments               Comment[]
  likes                  Like[]
  followers              Follow[]                @relation("Follower")
  following              Follow[]                @relation("Following")
  blockedBy              Block[]                 @relation("BlockedUser")
  blockedUsers           Block[]                 @relation("BlockerUser")
  followRequestsReceived FollowRequest[]         @relation("RequestedUser")
  followRequestsSent     FollowRequest[]         @relation("RequesterUser")
  notificationsReceived  Notification[]          @relation("ReceivedNotifications")
  notificationsSent      Notification[]          @relation("SentNotifications")
  stories                Story[]
  storyViews             StoryView[]
  refreshTokens          RefreshToken[]
  savedPosts             SavedPost[]
  savedArtworks          SavedArtwork[]
  messages               Message[]
  conversations          UserConversation[]
  commentReactions       CommentReaction[]
  articleComments        ArticleComment[]
  articleCommentLikes    ArticleCommentLike[]
  commentLikes           CommentLike[]
  notificationPreference NotificationPreference?
  collections            Collection[]            @relation("CollectionOwner")
  events                 Event[]                 @relation("EventOwner")
  eventComments          EventComment[]          @relation("EventCommentAuthor")
  eventParticipants      EventParticipant[]      @relation("EventParticipantUser")
  ticketPurchases        TicketPurchase[]        @relation("TicketPurchaseUser")
  auditLogs              AuditLog[]              @relation("AuditLogActor")
  jobListings            JobListing[]
  jobApplications        JobApplication[]        @relation("JobApplications")
  highlights             Highlight[]
  collectionItems        CollectionItem[]        @relation("CollectionItemAddedBy")
  reportsMade            UserReport[]            @relation("ReportsMade")
  reportsReceived        UserReport[]            @relation("ReportsReceived")
  contentReports         Report[]                @relation("ContentReports")
  emailChangeRequests    EmailChangeRequest[]
  roleChangeLogs         RoleChangeLog[]         @relation("RoleChanges")
  phoneVerifications     PhoneVerification[]

  @@map("users")
}

model Post {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  caption      String?
  title        String? // 🎨 Eser adı (artwork için)
  location     String?
  type         String   @default("post") // "post" | "artwork"
  code         String? // Artwork için otomatik üretilen kod (PA24-00001 gibi)
  colors       String[] @default([]) // Artwork için otomatik çıkarılan renkler (HEX formatında) - DEPRECATED
  colorPalette String[] @default([]) // 🎨 Basit renk paleti: hex string listesi (frontend'den gelir)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user            User
  media           PostMedia[]
  comments        Comment[]
  likes           Like[]
  hashtags        PostHashtag[]
  savedBy         SavedPost[]
  highlightCover  Highlight[]      @relation("HighlightCoverPost")
  highlightItems  HighlightItem[]
  collectionItems CollectionItem[]
  savedByArtworks SavedArtwork[]   @relation("SavedByArtworks")

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  postId       String @db.ObjectId
  type         String // 'image' | 'video'
  url          String
  thumbnailUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  post Post

  @@index([postId])
  @@map("post_media")
}

model Hashtag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  postId    String @db.ObjectId
  hashtagId String @db.ObjectId

  post    Post
  hashtag Hashtag

  @@unique([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String @db.ObjectId
  userId    String @db.ObjectId
  content   String
  parentId  String? @db.ObjectId // For nested comments
  isPinned  Boolean  @default(false) // Sabitlenmiş yorum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post
  user      User
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  likes     CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([postId, isPinned])
  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String @db.ObjectId
  userId    String @db.ObjectId
  emoji     String
  createdAt DateTime @default(now())

  comment Comment
  user    User

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

model Like {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String @db.ObjectId
  userId    String @db.ObjectId
  createdAt DateTime @default(now())

  post Post
  user User

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String @db.ObjectId
  followingId String @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model FollowRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String @db.ObjectId
  requestedId String @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([requesterId, requestedId])
  @@index([requestedId])
  @@index([requesterId])
  @@map("follow_requests")
}

model Block {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String @db.ObjectId
  blockedId String @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  type       String // 'like', 'comment', 'follow', 'follow_request', 'follow_accept', 'message', 'mention', 'reply', 'comment_like', 'job_application_received', 'job_application_status_changed', 'collection_added'
  message    String? // Bildirim metni (örn: "Ahmet gönderini beğendi")
  fromUserId String? @db.ObjectId
  postId     String? @db.ObjectId
  articleId  String? @db.ObjectId
  commentId  String? @db.ObjectId
  targetUrl  String? // Eski alan (geriye uyumluluk için)
  targetPath String? // Yeni alan: bildirime tıklandığında gidilecek Next.js route path
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId    @unique
  mention   Boolean   @default(true)
  follow    Boolean   @default(true)
  like      Boolean   @default(true)
  comment   Boolean   @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  user User

  @@map("notification_preferences")
}

model Story {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  mediaUrl  String
  mediaType String // 'image' | 'video'
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User
  views StoryView[]

  @@index([userId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  storyId  String @db.ObjectId
  userId   String @db.ObjectId
  viewedAt DateTime @default(now())

  story Story
  user  User

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_views")
}

model FeedCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  postIds   String[] // Array of post IDs
  updatedAt DateTime @default(now())

  @@unique([userId])
  @@map("feed_cache")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String @db.ObjectId
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  postId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User
  post Post

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

model SavedArtwork {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  postId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_artworks")
}

model Conversation {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants UserConversation[]
  messages     Message[]

  @@index([createdAt])
  @@map("conversations")
}

model UserConversation {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String @db.ObjectId
  conversationId String @db.ObjectId
  isDeleted      Boolean      @default(false) // Kullanıcıya özel sohbet silme (soft delete)
  createdAt      DateTime     @default(now())
  user           User
  conversation   Conversation

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, isDeleted])
  @@map("user_conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  content        String?
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  fileType       String?
  senderId       String @db.ObjectId
  conversationId String @db.ObjectId
  read           Boolean      @default(false)
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sender         User
  conversation   Conversation

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([read])
  @@map("messages")
}

model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  coverImage  String?
  excerpt     String?
  isPublished Boolean   @default(false)
  scheduledAt DateTime?
  views       Int       @default(0)
  authorId    String @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User
  comments ArticleComment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isPublished])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String @db.ObjectId
  userId    String @db.ObjectId
  content   String
  parentId  String? @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article
  user    User
  replies ArticleComment[]     @relation("CommentReplies")
  likes   ArticleCommentLike[]

  @@index([articleId])
  @@index([parentId])
  @@index([userId])
  @@map("article_comments")
}

model ArticleCommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String @db.ObjectId
  userId    String @db.ObjectId
  createdAt DateTime @default(now())

  comment ArticleComment
  user    User

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("article_comment_likes")
}

model JobListing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  company     String?
  location    String?
  salary      String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User
  createdById  String
  applications JobApplication[]

  @@index([createdAt])
  @@index([createdById])
  @@map("job_listings")
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model JobApplication {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  jobListingId String @db.ObjectId
  jobListing   JobListing

  applicantId String @db.ObjectId

  coverLetter      String?
  portfolioUrl     String?
  portfolioFileUrl String? // Yüklenen portfolyo dosyası URL'i
  cvUrl            String?

  status ApplicationStatus @default(PENDING)

  expiresAt      DateTime? // 30 günlük yanıt süresi (başvuru tarihinden itibaren)
  reminderSentAt DateTime? // Son hatırlatma bildirimi gönderilme tarihi

  // Admin özellikleri (sadece ilan sahibi görür)
  adminNote String? // Admin için özel notlar (aday görmez)
  tags      String[] @default([]) // Etiketler: ["öncelikli", "portfolyo-güçlü", vb.]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activities ApplicationActivity[]

  @@unique([jobListingId, applicantId])
  @@index([jobListingId])
  @@index([applicantId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationActivity {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String @db.ObjectId
  application   JobApplication

  action  String // "APPROVED" | "REJECTED" | "REVIEWED" | "NOTE_ADDED" | "TAG_ADDED" | "TAG_REMOVED" | "MAIL_SENT"
  details String? // Ek bilgiler (örn: eklenen etiket, not içeriği özeti)

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_activities")
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String @db.ObjectId
  userId    String @db.ObjectId
  createdAt DateTime @default(now())

  comment Comment
  user    User

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model Collection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  coverImage  String?
  ownerId     String @db.ObjectId
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]

  @@index([ownerId])
  @@index([createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  collectionId String @db.ObjectId
  postId       String @db.ObjectId // Post modeli artwork'leri de içeriyor (type="artwork")
  addedById    String @db.ObjectId
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection
  post       Post

  @@unique([collectionId, postId])
  @@index([collectionId, order])
  @@index([postId])
  @@map("collection_items")
}

model Event {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String?
  coverImage       String?
  date             DateTime
  participantCount Int       @default(0)
  ticketUrl        String?
  price            Float     @default(0)
  isFree           Boolean   @default(true)
  location         String?
  ownerId          String @db.ObjectId
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comments     EventComment[]
  participants EventParticipant[] @relation("EventParticipants")
  tickets      Ticket[]

  @@index([ownerId])
  @@index([date])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("events")
}

model EventComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  createdAt DateTime @default(now())
  eventId   String @db.ObjectId
  authorId  String @db.ObjectId

  event  Event

  @@index([eventId])
  @@index([authorId])
  @@index([createdAt])
  @@map("event_comments")
}

enum EventParticipantStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventParticipant {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  eventId        String @db.ObjectId
  userId         String @db.ObjectId
  status         EventParticipantStatus @default(PENDING)
  reminderSentAt DateTime?
  createdAt      DateTime               @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reminderSentAt])
  @@map("event_participants")
}

model Ticket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String @db.ObjectId
  type      String
  price     Float
  capacity  Int
  sold      Int      @default(0)
  qrCodeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event
  purchases TicketPurchase[]

  @@index([eventId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketPurchase {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String @db.ObjectId
  userId    String @db.ObjectId
  code      String    @unique
  qrUrl     String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  ticket Ticket

  @@index([ticketId])
  @@index([userId])
  @@index([used])
  @@index([createdAt])
  @@map("ticket_purchases")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String @db.ObjectId
  action    String // 'user.ban', 'post.delete', 'role.update', etc.
  target    String? // 'user:abc123', 'post:xyz789', etc.
  meta      Json? // Additional context data
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([target])
  @@map("audit_logs")
}

model FeatureFlag {
  key       String   @id @map("_id")
  enabled   Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("feature_flags")
}

model Highlight {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  coverPostId String? @db.ObjectId
  userId      String @db.ObjectId
  user        User
  items       HighlightItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("highlights")
}

model HighlightItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  highlightId String @db.ObjectId
  highlight   Highlight
  postId      String @db.ObjectId
  post        Post
  sortOrder   Int       @default(0)

  @@unique([highlightId, postId])
  @@index([highlightId])
  @@index([postId])
  @@map("highlight_items")
}

enum ReportReason {
  HARASSMENT
  SPAM
  HATE_SPEECH
  HATE
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  OTHER
}

model UserReport {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  reporterId     String @db.ObjectId
  reportedUserId String @db.ObjectId
  conversationId String? @db.ObjectId
  messageId      String?
  reason         ReportReason
  note           String?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reporterId])
  @@map("user_reports")
}

model Report {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  reporterId  String @db.ObjectId
  contentId   String
  contentType String // "post" | "comment"
  reason      ReportReason
  note        String?
  status      String       @default("OPEN")
  createdAt   DateTime     @default(now())

  @@index([contentType, contentId])
  @@index([status, createdAt])
  @@index([reporterId])
  @@map("reports")
}

model EmailChangeRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User

  @@index([userId])
  @@index([expiresAt])
  @@map("email_change_requests")
}

model RoleChangeLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String @db.ObjectId
  changedById String @db.ObjectId // Admin user id
  oldRoles    String // JSON.stringify([...])
  newRoles    String // JSON.stringify([...])
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([changedById])
  @@index([createdAt])
  @@map("role_change_logs")
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?  // Admin user id who updated this

  @@map("settings")
}

model PhoneVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  phoneNumber String
  code      String   // 6 haneli kod
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User

  @@index([userId])
  @@index([phoneNumber])
  @@index([code])
  @@index([expiresAt])
  @@map("phone_verifications")
}
