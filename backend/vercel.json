{
  "version": 2,
  "// DEPLOY_TRIGGER": "2026-01-23-19-47-BACKEND-DEPLOY-REQUIRED",
  "buildCommand": "npm install --legacy-peer-deps && npx prisma generate && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
