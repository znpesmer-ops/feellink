{
  "version": 2,
  "name": "feellink-backend",
  "buildCommand": "npm install --legacy-peer-deps && npx prisma generate && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
